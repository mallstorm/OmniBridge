<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="45"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Логи" Style="{StaticResource PageTitle}"/><TextBlock Text="Структурированные события Core, провайдеров, Model Doctor и интеграции." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnLogsFolder" Style="{StaticResource QuietButton}" Content="Открыть папку" Margin="0,0,8,0"/><Button x:Name="BtnLogsRefresh" Style="{StaticResource QuietButton}" Content="Обновить" Width="105"/></StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="9,4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                <Grid>
                    <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Text3Brush}" StrokeThickness="1.5" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" Stretch="Uniform"/>
                    <TextBox x:Name="LogsSearch" Margin="30,0,0,0" BorderThickness="0" Background="Transparent" Padding="3,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="LogsSearchPlaceholder" Text="" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="LogsLevel" Grid.Column="2"><ComboBoxItem Content="Все уровни" IsSelected="True"/><ComboBoxItem Content="INFO"/><ComboBoxItem Content="WARN"/><ComboBoxItem Content="ERROR"/><ComboBoxItem Content="DEBUG"/></ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="11,9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Журнал событий" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="LogsCount" Text="0 событий" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="LogsList" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#172B3F" BorderThickness="0,0,0,1" Padding="5,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition Width="64"/><ColumnDefinition Width="98"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding time}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding level}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D8C7A6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding level}" Value="WARN"><Setter Property="Foreground" Value="#F0D259"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding level}" Value="ERROR"><Setter Property="Foreground" Value="#FF8290"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding level}" Value="DEBUG"><Setter Property="Foreground" Value="#A88BFF"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding source}" FontSize="11.5" Foreground="#65BFFF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding message}" FontFamily="Consolas" FontSize="11.8" TextWrapping="Wrap" Foreground="#C9D5E3" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="LogsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#10243A" BorderBrush="#244764" BorderThickness="1"><Path Data="{StaticResource IconLog}" Stroke="{StaticResource Text3Brush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/></Border>
                        <TextBlock Text="Событий не найдено" Style="{StaticResource EmptyStateTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Измените поиск или уровень фильтрации." Style="{StaticResource EmptyStateText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
