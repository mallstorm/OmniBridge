<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="О программе" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="OmniBridge — Universal AI Gateway" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="56*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="44*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource HeroGradient}" BorderBrush="#24547D" BorderThickness="1" CornerRadius="14" Padding="25">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="92" Height="92" CornerRadius="46" Background="#0A2D59" BorderBrush="#49BEFF" BorderThickness="2" Effect="{StaticResource GlowBlue}">
                        <Image x:Name="AboutLogo" Width="78" Height="78"/>
                    </Border>
                    <TextBlock Text="OmniBridge" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" Margin="0,19,0,0"/>
                    <TextBlock Text="Universal AI Gateway" FontSize="14" Foreground="{StaticResource Text2Brush}" Margin="0,5,0,0"/>
                    <Border Background="#211448" BorderBrush="#5734A7" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,15,0,0">
                        <TextBlock x:Name="AboutVersion" Text="Версия 1.0.0-rc6" FontSize="10.5" Foreground="#C9B6FF"/>
                    </Border>
                    <TextBlock Text="Один локальный endpoint для облачных, account-based и локальных AI-моделей." TextAlignment="Center" TextWrapping="Wrap" Width="360" Style="{StaticResource PageSubtitle}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Архитектура" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Один OmniBridge.exe объединяет Core, Desktop и Tray. Окно и локальный Gateway используют единый lifecycle." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,10,0,0"/>
                        <Border Height="1" Background="#1A3045" Margin="0,13"/>
                        <TextBlock Text="Компоненты" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/>
                        <TextBlock Text="OmniBridge Core · Provider Registry · Model Registry · Model Doctor · Router · VS Code Connector" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Безопасность" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="localhost по умолчанию · отдельный admin key · DPAPI для секретов на Windows · redaction чувствительных данных в логах." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="UI 3.0" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Новый Shell, отдельные страницы и единая semantic design system созданы с нуля для этого релиза." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
