<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="160"/><RowDefinition Height="10"/><RowDefinition Height="52"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Интеграция" Style="{StaticResource PageTitle}"/><TextBlock Text="OmniBridge экспортирует проверенные модели в VS Code, Cline и другие OpenAI-compatible клиенты." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel>
        <Border Grid.Row="2" Background="{StaticResource HeroGradient}" BorderBrush="#24547D" BorderThickness="1" CornerRadius="13" Padding="18,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="14" Background="#0B3464" BorderBrush="#2789E9" BorderThickness="1" Effect="{StaticResource GlowBlue}"><Path Data="{StaticResource IconCode}" Stroke="#32AAFF" StrokeThickness="2" Width="32" Height="32" Stretch="Uniform"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="OmniBridge Client Connector" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="VS Code синхронизируется автоматически. Cline подключается как OpenAI Compatible к локальному Gateway и получает список Model ID через /v1/models." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Width="490" HorizontalAlignment="Left" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse x:Name="VSStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,2,7,0"/><TextBlock x:Name="VSStatus" Text="Gateway готов к подключению" FontSize="10.5" Foreground="{StaticResource SuccessBrush}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="BtnVSSync" Style="{StaticResource PrimaryButton}" Content="Синхронизировать модели"/><Button x:Name="BtnVSOpen" Style="{StaticResource QuietButton}" Content="Открыть настройки VS Code" Margin="0,8,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="13,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="8" Background="#16304A"><Path Data="{StaticResource IconSettings}" Stroke="#58C3FF" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Integration Hub" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock x:Name="IntegrationHubState" Text="Cline, VS Code и другие клиенты" Style="{StaticResource SecondaryText}"/><TextBlock Text="  ·  " Style="{StaticResource SecondaryText}"/><TextBlock x:Name="IntegrationHubDetected" Text="обнаружено: 0" Foreground="#64EA88" FontSize="10.5"/></StackPanel></StackPanel></StackPanel><Button x:Name="BtnIntegrationHubRefresh" Grid.Column="1" Style="{StaticResource QuietButton}" Width="116" Height="30" Content="Проверить" VerticalAlignment="Center"/></Grid></Border>
        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15,12"><StackPanel><TextBlock Text="Локальный Gateway / Cline" Style="{StaticResource SectionTitle}"/><TextBlock Text="ENDPOINT" Style="{StaticResource Kicker}" Margin="0,13,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Border Background="#08131F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,9"><TextBlock x:Name="VSEndpoint" Text="http://127.0.0.1:4142/v1" FontFamily="Consolas" FontSize="12.5"/></Border><Button x:Name="BtnCopyEndpoint" Grid.Column="2" Style="{StaticResource QuietButton}" Content="Копировать endpoint" Height="34"/></Grid><TextBlock Text="LOCAL BRIDGE KEY" Style="{StaticResource Kicker}" Margin="0,12,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Border Background="#08131F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,9"><TextBlock x:Name="VSKey" Text="••••••••••••••••••••••••" FontFamily="Consolas" FontSize="12.5"/></Border><Button x:Name="BtnCopyBridgeKey" Grid.Column="2" Style="{StaticResource QuietButton}" Content="Копировать ключ" Height="34"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="BtnClineTest" Style="{StaticResource QuietButton}" Width="136" Height="30" Content="Проверить Cline API"/><TextBlock x:Name="ClineStatus" Text="Cline API: не проверено" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Cline: Provider = OpenAI Compatible. Base URL = endpoint выше. API Key = Local Bridge Key. Model ID загружается из GET /v1/models." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15,12"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Экспорт моделей" Style="{StaticResource SectionTitle}"/><StackPanel Grid.Row="1"><Grid Margin="0,8"><TextBlock Text="Agent Ready" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="VSAgentCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontSize="11"/></Grid><Border Height="1" Background="#1A3045"/><Grid Margin="0,9"><TextBlock Text="Chat Ready" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="VSChatCount" Text="0" HorizontalAlignment="Right" Foreground="#52B8FF" FontSize="11"/></Grid><Border Height="1" Background="#1A3045"/><Grid Margin="0,9"><TextBlock Text="Error — не экспортируются" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="VSErrorCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource ErrorBrush}" FontSize="11"/></Grid><Border Height="1" Background="#1A3045"/><TextBlock x:Name="VSLastSync" Text="Последняя синхронизация: ещё не выполнялась" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/><TextBlock Text="Cline читает модели напрямую из Gateway. Для VS Code Visibility по-прежнему управляется самим VS Code." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,7,0,0"/></StackPanel><Button x:Name="BtnVSRefresh" Grid.Row="2" Style="{StaticResource QuietButton}" Content="Перечитать состояние" VerticalAlignment="Bottom"/></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
