<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Сервисы" Style="{StaticResource PageTitle}"/><TextBlock Text="Quota &amp; Cost, Context Guard, MCP и наблюдаемость — функциональные сервисы Core 1.0." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel><Button x:Name="BtnServicesRefresh" Style="{StaticResource QuietButton}" Width="110" Height="31" Content="Обновить" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <Grid><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="8" Background="#16304A"><Path Data="{StaticResource IconArrow}" Stroke="#58C3FF" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Quota &amp; Cost Engine" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SvcQuotaState" Text="Нет подтверждённых лимитов" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock x:Name="SvcQuotaBadge" Text="1.0" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid Margin="0,4"><TextBlock Text="Известная квота" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcQuotaKnown" Text="0 подключений" HorizontalAlignment="Right" Foreground="#63C8FF"/></Grid><Grid Margin="0,6"><TextBlock Text="Известные цены" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcPricingKnown" Text="0 моделей" HorizontalAlignment="Right" Foreground="#B99AFF"/></Grid><Grid Margin="0,6"><TextBlock Text="Расходы за 24 ч." Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcDailyCost" Text="$0.0000" HorizontalAlignment="Right" Foreground="#64EA88"/></Grid><TextBlock Text="Unknown никогда не трактуется как free или unlimited." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <Button x:Name="BtnQuotaRefresh" Grid.Row="2" Style="{StaticResource QuietButton}" Content="Обновить квоты" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <Grid><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="8" Background="#233A24"><Path Data="{StaticResource IconDoctor}" Stroke="#64EA88" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Context Guard" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SvcContextState" Text="Compact · включён" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock x:Name="SvcContextBadge" Text="1.0" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid Margin="0,4"><TextBlock Text="Событий compaction" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcContextEvents" Text="0" HorizontalAlignment="Right"/></Grid><Grid Margin="0,6"><TextBlock Text="Сэкономлено токенов" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcContextSaved" Text="0" HorizontalAlignment="Right" Foreground="#64EA88"/></Grid><Grid Margin="0,6"><TextBlock Text="Порог контекста" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcContextPercent" Text="90%" HorizontalAlignment="Right"/></Grid><TextBlock Text="Системные инструкции и последние сообщения сохраняются; старый контекст удаляется только при превышении проверенного окна." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <Button x:Name="BtnContextToggle" Grid.Row="2" Style="{StaticResource QuietButton}" Content="Отключить Guard" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <Grid><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="8" Background="#2C2248"><Path Data="{StaticResource IconCube}" Stroke="#B99AFF" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="MCP Control Plane" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SvcMCPState" Text="Серверы не настроены" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Text="1.0" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid Margin="0,4"><TextBlock Text="Настроено" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcMCPCount" Text="0" HorizontalAlignment="Right"/></Grid><Grid Margin="0,6"><TextBlock Text="Включено" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcMCPEnabled" Text="0" HorizontalAlignment="Right"/></Grid><Grid Margin="0,6"><TextBlock Text="Ready / reachable" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcMCPReady" Text="0" HorizontalAlignment="Right" Foreground="#64EA88"/></Grid><TextBlock Text="STDIO process launch запрещён по умолчанию и требует явного разрешения для конкретного сервера." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <Button x:Name="BtnMCPProbeAll" Grid.Row="2" Style="{StaticResource QuietButton}" Content="Проверить MCP" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <Grid><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="8" Background="#16304A"><Path Data="{StaticResource IconLog}" Stroke="#58C3FF" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Observability &amp; Remote" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SvcRemoteState" Text="Remote выключен · localhost only" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Text="1.0" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid Margin="0,4"><TextBlock Text="HTTP запросов" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcObsRequests" Text="0" HorizontalAlignment="Right"/></Grid><Grid Margin="0,6"><TextBlock Text="Ошибок" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcObsErrors" Text="0" HorizontalAlignment="Right" Foreground="#FF8290"/></Grid><Grid Margin="0,6"><TextBlock Text="Request Trace" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="SvcTraceState" Text="Persistent · SQLite" HorizontalAlignment="Right" Foreground="#64EA88"/></Grid><TextBlock Text="Трассы не сохраняют prompt или секретные заголовки. Remote bind работает только с TLS и CIDR allow-list." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnOpenLogsFromServices" Style="{StaticResource QuietButton}" Width="105" Content="Открыть логи"/><Button x:Name="BtnOpenIntegrationFromServices" Style="{StaticResource QuietButton}" Width="120" Content="Интеграции" Margin="8,0,0,0"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
