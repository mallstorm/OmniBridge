<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/><TextBlock Text="Server lifecycle, данные, резервное копирование и базовая маршрутизация." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Height="202" Padding="15,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="Локальный сервер" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Grid.Row="1"><TextBlock Text="АДРЕС И ПОРТ" Style="{StaticResource Kicker}" Margin="0,7,0,5"/><TextBox x:Name="SettingsListen" IsReadOnly="True"/><TextBlock Text="Core доступен только на localhost; публичное подключение не включается автоматически." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                        <Button x:Name="BtnRestartServer" Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Перезапустить сервер" Width="155" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Height="196" Padding="15,12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <TextBlock Text="Данные и резервные копии" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="ПАПКА ДАННЫХ" Style="{StaticResource Kicker}" Margin="0,7,0,5"/>
                            <Border Height="36" Background="#0A1725" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0"><TextBlock x:Name="SettingsDataPath" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></Border>
                            <TextBlock Text="Backup: config, Model Registry, маршруты и статистика. Секреты — отдельно." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button x:Name="BtnOpenData" Style="{StaticResource QuietButton}" Content="Открыть папку" Margin="0,0,8,0"/><Button x:Name="BtnBackup" Style="{StaticResource PrimaryButton}" Content="Создать backup" Width="125"/></StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Height="286" Padding="15,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="OmniBridge Router" Style="{StaticResource SectionTitle}"/><Border HorizontalAlignment="Right" Background="#12385D" CornerRadius="5" Padding="7,3"><TextBlock Text="ROUTER 3.1 · AUTO" FontSize="8.5" Foreground="#8FD2FF"/></Border></Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ALIAS" Style="{StaticResource Kicker}" Margin="0,3,0,4"/><TextBox x:Name="RouteAlias" ToolTip="Например: coding-fast"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MODEL ID" Style="{StaticResource Kicker}" Margin="0,3,0,4"/><ComboBox x:Name="RouteModel" DisplayMemberPath="display"/></StackPanel></Grid>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><TextBlock Text="Псевдонимы моделей" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><Button x:Name="BtnRouteDelete" Style="{StaticResource DangerButton}" Content="Удалить" Height="25" HorizontalAlignment="Right"/></Grid>
                            <Grid Grid.Row="1"><ListBox x:Name="RoutesList"><ListBox.ItemTemplate><DataTemplate><Border Background="#0D1B2A" BorderBrush="#1A3148" BorderThickness="1" CornerRadius="7" Padding="9,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding alias}" FontSize="10.5" FontWeight="SemiBold"/><Path Grid.Column="1" Data="{StaticResource IconArrow}" Stroke="{StaticResource BlueBrightBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/><TextBlock Grid.Column="2" Text="{Binding target}" FontSize="10" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="RoutesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Маршрутов пока нет" Style="{StaticResource EmptyStateTitle}"/><TextBlock Text="Выберите модель и создайте короткий alias." Style="{StaticResource EmptyStateText}" Margin="0,3,0,0"/></StackPanel></Grid>
                        </Grid>
                        <Button x:Name="BtnRouteSave" Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="Добавить или обновить alias" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Height="108" Padding="15,11" Margin="0,10,0,0">
                    <Grid><StackPanel Margin="0,0,125,0"><TextBlock Text="Версия и обслуживание" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SettingsVersion" Text="1.0.0-rc5" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/><TextBlock Text="Portable-данные не переносятся автоматически." Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel><Button x:Name="BtnOpenRoot" Style="{StaticResource QuietButton}" Content="Открыть OmniBridge" Width="112" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
