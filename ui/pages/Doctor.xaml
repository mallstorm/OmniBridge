<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="116"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Model Doctor" Style="{StaticResource PageTitle}"/><TextBlock Text="Практическая проверка возможностей + Doctor / Agent / Coding / Reliability Score." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel>

        <Border Grid.Row="2" Background="{StaticResource HeroGradient}" BorderBrush="#28654E" BorderThickness="1" CornerRadius="13" Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" Background="#103C32" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2" Effect="{StaticResource GlowGreen}"><Path Data="{StaticResource IconDoctor}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="Проверьте модели перед использованием" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="Глубокая проверка выполняет реальные короткие запросы и может расходовать небольшой объём квоты." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Kicker}" Margin="1,0,0,4"/><ComboBox x:Name="DoctorProvider" DisplayMemberPath="display"/><Button x:Name="BtnDoctorStart" Style="{StaticResource PrimaryButton}" Content="Запустить проверку" Margin="0,7,0,0" IsEnabled="False"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="66*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="34*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Результаты проверки" Style="{StaticResource SectionTitle}"/><Button x:Name="BtnDoctorReportRefresh" Content="Обновить" Style="{StaticResource QuietButton}" Height="26" HorizontalAlignment="Right"/></Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="DoctorReport"><ListBox.ItemTemplate><DataTemplate><Border Background="#0D1B2A" BorderBrush="#1A3148" BorderThickness="1" CornerRadius="8" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="23" Height="23" CornerRadius="6" Background="#162C4C" BorderBrush="#294963" BorderThickness="1" Padding="2"><Image Source="{Binding icon}" Width="18" Height="18" Stretch="Uniform"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding name}" FontSize="11.2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding provider}" FontSize="9.2" Foreground="{StaticResource Text2Brush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding chat}" Foreground="{Binding chat_color}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding stream}" Foreground="{Binding stream_color}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding tools}" Foreground="{Binding tools_color}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding doctor_score}" Foreground="#6EC7FF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Doctor Score"/><TextBlock Grid.Column="6" Text="{Binding agent_score}" Foreground="#64EA88" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Agent Score"/><TextBlock Grid.Column="7" Text="{Binding coding_score}" Foreground="#B69AFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Coding Score"/><TextBlock Grid.Column="8" Text="{Binding reliability_score}" Foreground="#FFD45D" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Reliability Score"/><TextBlock Grid.Column="9" Text="{Binding class}" Foreground="{Binding class_color}" FontSize="9.2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <StackPanel x:Name="DoctorEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border Width="42" Height="42" CornerRadius="21" Background="#10382F" BorderBrush="#28654E" BorderThickness="1"><Path Data="{StaticResource IconDoctor}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.5" Width="21" Height="21" Stretch="Uniform"/></Border><TextBlock Text="Нет результатов проверки" Style="{StaticResource EmptyStateTitle}" Margin="0,10,0,0"/><TextBlock Text="Выберите подключение и запустите практический тест." Style="{StaticResource EmptyStateText}" Width="280" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,11"><StackPanel><TextBlock Text="Критерии" Style="{StaticResource SectionTitle}"/><Border Background="#0A1B2A" BorderBrush="#193850" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,10,0,0"><StackPanel><TextBlock Text="Agent Ready" Foreground="{StaticResource SuccessBrush}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Chat + streaming + tools проходят практическую проверку." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#221F14" BorderBrush="#554C22" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,8,0,0"><StackPanel><TextBlock Text="Chat Only / Partial" Foreground="{StaticResource WarningBrush}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Модель отвечает, но часть функций недоступна." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#29171D" BorderBrush="#5B2835" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,8,0,0"><StackPanel><TextBlock Text="Error / Rate Limited" Foreground="{StaticResource ErrorBrush}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Недоступность, авторизация, квота или временная ёмкость upstream." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
