<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="256"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="#0B1726" BorderBrush="#20334A" BorderThickness="1" CornerRadius="13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource HeroGradient}" CornerRadius="12,0,0,12" Padding="17,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="3" Effect="{StaticResource GlowGreen}" Background="#0A2A26"><Path Data="M5,25 L13,25 17,13 23,37 28,22 33,28 43,28" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.2" Stretch="Fill" Width="34" Height="25"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HeroState" Text="ВСЁ РАБОТАЕТ" Foreground="{StaticResource SuccessBrush}" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="HeroDescription" Text="OmniBridge активен и готов" FontSize="11.5" Margin="0,5,0,0"/><TextBlock Text="к обработке запросов" FontSize="11.5"/></StackPanel></Grid>
                    </Border>
                    <UniformGrid Grid.Column="1" Columns="4" Margin="4,9">
                        <Grid><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="MetricProviders" Text="0" FontSize="21" Foreground="#3EE7C2" HorizontalAlignment="Center"/><TextBlock Text="API провайдеров" FontSize="10.5" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" Width="1" Background="#172C42" Margin="0,7"/></Grid>
                        <Grid><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="MetricAccounts" Text="0" FontSize="21" Foreground="#35B7FF" HorizontalAlignment="Center"/><TextBlock Text="Аккаунта" FontSize="10.5" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" Width="1" Background="#172C42" Margin="0,7"/></Grid>
                        <Grid><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="MetricModels" Text="0" FontSize="21" Foreground="#9858FF" HorizontalAlignment="Center"/><TextBlock Text="Моделей" FontSize="10.5" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" Width="1" Background="#172C42" Margin="0,7"/></Grid>
                        <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="MetricReady" Text="0" FontSize="21" Foreground="#FFD244" HorizontalAlignment="Center"/><TextBlock Text="Agent Ready" FontSize="10.5" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0"/></StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
            <Border Grid.Column="3" Background="#0B1724" BorderBrush="#20334A" BorderThickness="1" CornerRadius="13" Padding="13,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="DashServerDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,3,8,0"/><TextBlock x:Name="DashServerState" Text="Локальный сервер" FontSize="10.5"/></StackPanel>
                    <TextBlock x:Name="DashServerEndpoint" Text="127.0.0.1:4142" FontSize="11" Margin="15,5,0,0" Foreground="{StaticResource Text2Brush}"/>
                    <TextBlock x:Name="DashServerVersion" Text="Версия: 1.0.0-rc7" FontSize="10" Margin="15,7,0,0" Foreground="{StaticResource Text2Brush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="32*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="25*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Быстрый доступ" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                        <Button x:Name="QuickApi" Style="{StaticResource QuietButton}" Height="Auto" Margin="0,0,5,5" Padding="10">
                            <StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconKey}" Stroke="#CFE3FF" StrokeThickness="1.5" Width="27" Height="27" Stretch="Uniform"/><TextBlock Text="API Ключи (Setup)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Добавление и управление" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="API провайдерами" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="QuickAccounts" Style="{StaticResource QuietButton}" Height="Auto" Margin="5,0,0,5" Padding="10">
                            <StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconAccount}" Stroke="#CFE3FF" StrokeThickness="1.5" Width="27" Height="27" Stretch="Uniform"/><TextBlock Text="Аккаунты (Login)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Вход через аккаунт" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="ChatGPT, Gemini" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="QuickDoctor" Style="{StaticResource QuietButton}" Height="Auto" Margin="0,5,5,0" Padding="10">
                            <StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconDoctor}" Stroke="#CFE3FF" StrokeThickness="1.5" Width="27" Height="27" Stretch="Uniform"/><TextBlock Text="Model Doctor" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Проверка моделей на" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="совместимость и возможности" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="QuickIntegration" Style="{StaticResource QuietButton}" Height="Auto" Margin="5,5,0,0" Padding="10">
                            <StackPanel VerticalAlignment="Center"><Path Data="{StaticResource IconCode}" Stroke="#26A4FF" StrokeThickness="1.6" Width="28" Height="28" Stretch="Uniform"/><TextBlock Text="Интеграция" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Управление моделями" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="в VS Code" FontSize="10.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"/></StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="13,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Аккаунты (Login)" Style="{StaticResource SectionTitle}"/><Border Background="#111D2C" CornerRadius="5" Padding="7,2" Margin="10,0,0,1" VerticalAlignment="Center"><TextBlock x:Name="DashAccountsConnected" Text="0 подключено" FontSize="9.5" Foreground="{StaticResource Text2Brush}"/></Border></StackPanel>
                        <Button x:Name="DashManageAccounts" Style="{StaticResource TransparentButton}" HorizontalAlignment="Right" Height="24" Padding="8,0"><TextBlock Text="Управление всеми аккаунтами  →" Foreground="#46AEFF" FontSize="10.5"/></Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource RaisedCard}" Padding="12,10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="DashChatIcon" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Top"/><StackPanel Grid.Column="1" VerticalAlignment="Top"><TextBlock Text="ChatGPT / Codex" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock x:Name="DashChatEmail" Text="Не подключён" FontSize="10.2" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="#351C62" CornerRadius="5" Padding="7,3" VerticalAlignment="Top"><TextBlock Text="Account" FontSize="9.5" Foreground="#D7C2FF"/></Border></Grid>
                                <StackPanel Grid.Row="1" Margin="0,7,0,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DashChatDot" Width="8" Height="8" Fill="{StaticResource Text3Brush}" Margin="0,2,8,0"/><TextBlock x:Name="DashChatState" Text="Ожидает входа" FontSize="10.5" Foreground="{StaticResource Text2Brush}"/></StackPanel><Border Height="1" Background="#1B3046" Margin="0,8"/><Grid><TextBlock Text="План" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashChatPlan" Text="—" HorizontalAlignment="Right" FontSize="10.5" Foreground="#B978FF"/></Grid><Grid Margin="0,7,0,0"><TextBlock Text="Моделей" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashChatModels" Text="0" HorizontalAlignment="Right" FontSize="10.5"/></Grid><Grid Margin="0,7,0,0"><TextBlock Text="Agent Ready" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashChatReady" Text="0" HorizontalAlignment="Right" FontSize="10.5"/></Grid></StackPanel>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button x:Name="DashOpenChat" Style="{StaticResource PrimaryButton}" Height="29" Content="Открыть ChatGPT настройки" FontSize="10"/><Button x:Name="DashChatMore" Grid.Column="2" Style="{StaticResource QuietButton}" Height="29" Padding="0" Content="•••" FontSize="11"/></Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource RaisedCard}" Padding="12,10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="DashGeminiIcon" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Top"/><StackPanel Grid.Column="1" VerticalAlignment="Top"><TextBlock Text="Google Gemini" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock x:Name="DashGeminiEmail" Text="Не подключён" FontSize="10.2" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="#351C62" CornerRadius="5" Padding="7,3" VerticalAlignment="Top"><TextBlock Text="Account" FontSize="9.5" Foreground="#D7C2FF"/></Border></Grid>
                                <StackPanel Grid.Row="1" Margin="0,7,0,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DashGeminiDot" Width="8" Height="8" Fill="{StaticResource Text3Brush}" Margin="0,2,8,0"/><TextBlock x:Name="DashGeminiState" Text="Ожидает входа" FontSize="10.5" Foreground="{StaticResource Text2Brush}"/></StackPanel><Border Height="1" Background="#1B3046" Margin="0,8"/><Grid><TextBlock Text="План" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashGeminiPlan" Text="—" HorizontalAlignment="Right" FontSize="10.5" Foreground="#46AEFF"/></Grid><Grid Margin="0,7,0,0"><TextBlock Text="Моделей" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashGeminiModels" Text="0" HorizontalAlignment="Right" FontSize="10.5"/></Grid><Grid Margin="0,7,0,0"><TextBlock Text="Agent Ready" FontSize="10.2" Foreground="{StaticResource Text2Brush}"/><TextBlock x:Name="DashGeminiReady" Text="0" HorizontalAlignment="Right" FontSize="10.5"/></Grid></StackPanel>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button x:Name="DashOpenGemini" Style="{StaticResource PrimaryButton}" Height="29" Content="Открыть Gemini настройки" FontSize="10"/><Button x:Name="DashGeminiMore" Grid.Column="2" Style="{StaticResource QuietButton}" Height="29" Padding="0" Content="•••" FontSize="11"/></Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="32*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="25*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,9">
                <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Недавно проверенные модели" Style="{StaticResource SectionTitle}"/><Button x:Name="DashAllModels" Style="{StaticResource TransparentButton}" HorizontalAlignment="Right" Height="22" Padding="7,0"><TextBlock Text="Все модели  →" Foreground="#46AEFF" FontSize="10"/></Button></Grid>
                    <Grid Grid.Row="1"><ListBox x:Name="DashModelsList"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#182C40" BorderThickness="0,0,0,1" Padding="3,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="64"/><ColumnDefinition Width="57"/><ColumnDefinition Width="11"/></Grid.ColumnDefinitions><Image Source="{Binding icon}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding provider}" FontSize="9" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" Background="{Binding badge_bg}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding badge}" Foreground="{Binding badge_fg}" FontSize="8.5"/></Border><TextBlock Grid.Column="3" Text="{Binding protocol}" FontSize="8.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding age}" FontSize="8.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/><Ellipse Grid.Column="5" Width="7" Height="7" Fill="{Binding state_brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="DashModelsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Проверок пока нет" Style="{StaticResource EmptyStateTitle}"/><TextBlock Text="Запустите Model Doctor" Style="{StaticResource EmptyStateText}" Margin="0,3,0,0"/></StackPanel></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
                <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Системная информация" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Grid Height="24"><TextBlock Text="Сервер" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemServer" Text="127.0.0.1:4142" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Статус" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="SystemStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock x:Name="SystemStatus" Text="Запущен" FontSize="10" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Uptime" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemUptime" Text="00:00:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Порт" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemPort" Text="4142" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Версия" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemVersion" Text="1.0.0-rc7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Конфигурация" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemRegistry" Text="Ожидает" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource SuccessBrush}"/></Grid><Border Height="1" Background="#192D41"/>
                        <Grid Height="24"><TextBlock Text="Синхронизация VS Code" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock x:Name="SystemVSCode" Text="Готов" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource SuccessBrush}"/></Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,9">
                <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Статистика (24ч)" Style="{StaticResource SectionTitle}"/>
                    <Border Grid.Row="1" Background="#0A1B2A" CornerRadius="7" BorderBrush="#16334A" BorderThickness="1" Padding="6"><Viewbox Stretch="Fill"><Canvas Width="210" Height="56"><Line X1="0" Y1="14" X2="210" Y2="14" Stroke="#153047" StrokeThickness="1"/><Line X1="0" Y1="28" X2="210" Y2="28" Stroke="#153047" StrokeThickness="1"/><Line X1="0" Y1="42" X2="210" Y2="42" Stroke="#153047" StrokeThickness="1"/><Polyline Points="0,56 0,46 14,38 28,41 42,19 56,17 70,25 84,40 98,45 112,42 126,43 140,34 154,36 168,24 182,36 196,15 210,25 210,56" Fill="#1838B9FF" StrokeThickness="0"/><Polyline x:Name="StatsLine" Points="0,46 14,38 28,41 42,19 56,17 70,25 84,40 98,45 112,42 126,43 140,34 154,36 168,24 182,36 196,15 210,25" Stroke="#38B9FF" StrokeThickness="2"/></Canvas></Viewbox></Border>
                    <StackPanel Grid.Row="2" Margin="0,9,0,0"><Grid><TextBlock Text="Запросов" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="StatsRequests" Text="0" HorizontalAlignment="Right" FontSize="10"/></Grid><Border Height="1" Background="#192D41" Margin="0,6"/><Grid><TextBlock Text="Входящие / кэш" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="StatsInput" Text="0 / 0" HorizontalAlignment="Right" FontSize="10"/></Grid><Grid Margin="0,6,0,0"><TextBlock Text="Исходящие токены" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="StatsOutput" Text="0" HorizontalAlignment="Right" FontSize="10"/></Grid><Grid Margin="0,6,0,0"><TextBlock Text="Среднее время ответа" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="StatsLatency" Text="—" HorizontalAlignment="Right" FontSize="10"/></Grid></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
