<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="88"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Умная маршрутизация" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Router 3.1 Adaptive: Doctor proof, EWMA quality, quota-share и объяснимый выбор." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="BtnRouterExplain" Style="{StaticResource QuietButton}" Content="Почему модель" Width="124"/><Button x:Name="BtnRouterRefresh" Style="{StaticResource QuietButton}" Content="Обновить" Width="104" Margin="8,0,0,0"/></StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Style="{StaticResource Card}" Padding="13,9" Margin="0,0,7,0">
                <StackPanel><TextBlock Text="ROUTER" Style="{StaticResource Kicker}"/><TextBlock x:Name="RouterVersion" Text="3.1" FontSize="21" Foreground="#46B8FF" Margin="0,4,0,0"/><TextBlock Text="Adaptive · Explainable" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="13,9" Margin="3,0,4,0">
                <StackPanel><TextBlock Text="AUTO МОДЕЛИ" Style="{StaticResource Kicker}"/><TextBlock x:Name="RouterVirtualCount" Text="8" FontSize="21" Foreground="#9C72FF" Margin="0,4,0,0"/><TextBlock Text="виртуальных профилей" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="13,9" Margin="4,0,3,0">
                <StackPanel><TextBlock Text="SESSION AFFINITY" Style="{StaticResource Kicker}"/><TextBlock x:Name="RouterAffinityCount" Text="0" FontSize="21" Foreground="#3DE2B6" Margin="0,4,0,0"/><TextBlock Text="активных привязок" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="13,9" Margin="7,0,0,0">
                <StackPanel><TextBlock Text="CONNECTION POOLS" Style="{StaticResource Kicker}"/><TextBlock x:Name="RouterPoolsHealthy" Text="0 / 0" FontSize="21" Foreground="#FFD45D" Margin="0,4,0,0"/><TextBlock x:Name="RouterBreakerSummary" Text="0 breaker open" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="57*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="43*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Auto Router · порядок кандидатов" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="RouterCandidateCount" Text="0 кандидатов" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,3,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="ВИРТУАЛЬНАЯ МОДЕЛЬ" Style="{StaticResource Kicker}" Margin="0,0,0,4"/><ComboBox x:Name="RouterProfile" DisplayMemberPath="display"/></StackPanel>
                        <Border Grid.Column="2" Background="#0A1725" BorderBrush="#1A344D" BorderThickness="1" CornerRadius="7" Padding="10,6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="RouterProfileHint" Text="Router выбирает фактическую модель по Doctor, health, latency и runtime telemetry." FontSize="10" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="RouterCandidates">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Background="#0D1B2A" BorderBrush="#1A3148" BorderThickness="1" CornerRadius="8" Padding="9,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding rank}" Foreground="#6DBEFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding model}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding provider}" FontSize="9.5" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding score}" Foreground="#B798FF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding detail}" FontSize="9.3" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="RouterCandidatesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Нет совместимых кандидатов" Style="{StaticResource EmptyStateTitle}"/><TextBlock Text="Обновите Model Registry или выполните Model Doctor." Style="{StaticResource EmptyStateText}" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="54*"/><RowDefinition Height="10"/><RowDefinition Height="46*"/></Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="13,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="Connection Pool · Resilience" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RouterResilienceState" Text="Persistent" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="RouterPoolsList">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="#0D1B2A" BorderBrush="#1A3148" BorderThickness="1" CornerRadius="8" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding members}" FontSize="9.5" Foreground="{StaticResource Text2Brush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding state}" Foreground="{Binding state_color}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding models}" Foreground="{StaticResource Text2Brush}" FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="RouterPoolsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Connection Pool пуст" Style="{StaticResource EmptyStateTitle}"/><TextBlock Text="Добавьте API или Account Connector." Style="{StaticResource EmptyStateText}" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="Dry-run · анализ запроса" Style="{StaticResource SectionTitle}"/><TextBlock Text="без обращения к upstream" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></Grid>
                        <Grid Grid.Row="1" Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><ComboBox x:Name="RouterTestProfile" DisplayMemberPath="display"/><ComboBox x:Name="RouterTestType" Grid.Column="2" DisplayMemberPath="display"/><Button x:Name="BtnRouterEvaluate" Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="Оценить"/></Grid>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="RouterTestState" Text="Выберите профиль запроса." FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/>
                            <TextBlock x:Name="RouterRequirements" Text="Requirements: —" FontSize="9.8" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="RouterDecision" Text="Маршрут: —" FontSize="9.8" Foreground="#7CC8FF" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
