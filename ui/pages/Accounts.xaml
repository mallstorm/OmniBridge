<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid Margin="18,15">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition Height="318"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Аккаунты" Style="{StaticResource PageTitle}"/><TextBlock Text="Официальная авторизация ChatGPT/Codex и Google Gemini — отдельно от API-ключей." Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/></StackPanel>
            <Button x:Name="BtnAccountsRefresh" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Width="112" Content="Обновить"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image x:Name="ChatAccountIcon" Width="34" Height="34"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="ChatGPT / Codex" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="Account Connector" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel>
                        <Border Grid.Column="2" Background="#351D68" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="OFFICIAL LOGIN" FontSize="9" Foreground="#D9C5FF"/></Border>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="OmniBridge использует поддерживаемый локальный Codex login flow и не хранит пароль пользователя." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}"/>
                        <Border Background="#0A1B2A" BorderBrush="#193850" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel><TextBlock Text="Вход через браузер" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="Обычный вход и Device Flow. После авторизации окно браузера можно закрыть." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Expander x:Name="ChatAdvanced" Header="Расширенные параметры" Foreground="{StaticResource Text2Brush}" FontSize="10.5" Margin="0,7,0,0">
                            <Grid Margin="0,5,0,0"><TextBox x:Name="CodexPath" ToolTip="Путь к Codex CLI (необязательно)"/><Button x:Name="BtnBrowseCodex" Style="{StaticResource QuietButton}" Content="Обзор" HorizontalAlignment="Right" Width="72" Height="30" Margin="0,3,3,0"/></Grid>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button x:Name="BtnChatDevice" Style="{StaticResource QuietButton}" Content="Device Flow" Width="110" Margin="0,0,8,0"/><Button x:Name="BtnChatLogin" Style="{StaticResource PrimaryButton}" Content="Войти в ChatGPT" Width="135"/></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image x:Name="GeminiAccountIcon" Width="34" Height="34"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Google Gemini" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="OAuth Account Connector" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/></StackPanel>
                        <Border Grid.Column="2" Background="#163957" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="OAUTH 2.0" FontSize="9" Foreground="#88D4FF"/></Border>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Google OAuth открывается в браузере. Для Developer API OAuth требуется Desktop OAuth JSON вашего Google Cloud проекта." TextWrapping="Wrap" Style="{StaticResource PageSubtitle}"/>
                        <Border Background="#0A1B2A" BorderBrush="#193850" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel><TextBlock Text="Авторизация Google" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/><TextBlock Text="После подтверждения модели добавляются в отдельный Account Registry." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <Expander x:Name="GeminiAdvanced" Header="Расширенные параметры" Foreground="{StaticResource Text2Brush}" FontSize="10.5" Margin="0,7,0,0">
                            <Grid Margin="0,5,0,0"><TextBox x:Name="GeminiClientPath" ToolTip="Google Desktop OAuth client JSON (обязательно для Developer API OAuth)"/><Button x:Name="BtnBrowseGemini" Style="{StaticResource QuietButton}" Content="Обзор" HorizontalAlignment="Right" Width="72" Height="30" Margin="0,3,3,0"/></Grid>
                        </Expander>
                    </StackPanel>
                    <Button x:Name="BtnGeminiLogin" Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Войти через Google" Width="145" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="13,9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Подключённые аккаунты" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnAccountInfo" Style="{StaticResource QuietButton}" Content="Тариф и лимиты" Height="27" Margin="0,0,7,0"/><Button x:Name="BtnAccountRefresh" Style="{StaticResource QuietButton}" Content="Обновить модели" Height="27" Margin="0,0,7,0"/><Button x:Name="BtnAccountLogout" Style="{StaticResource DangerButton}" Content="Выйти" Height="27"/></StackPanel></Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="AccountsList">
                        <ListBox.ItemTemplate><DataTemplate><Border Background="#0D1B2A" BorderBrush="#1B3148" BorderThickness="1" CornerRadius="8" Padding="10,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconAccount}" Stroke="#74C3FF" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding name}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="{Binding kind}" FontSize="9.5" Foreground="{StaticResource Text2Brush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding email}" FontSize="10" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding plan}" FontSize="10" Foreground="#B879FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding state}" FontSize="10" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="AccountsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border Width="38" Height="38" CornerRadius="19" Background="#10243A" BorderBrush="#244764" BorderThickness="1"><Path Data="{StaticResource IconAccount}" Stroke="{StaticResource Text3Brush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/></Border><TextBlock Text="Нет подключённых аккаунтов" Style="{StaticResource EmptyStateTitle}" Margin="0,9,0,0"/><TextBlock Text="Авторизуйтесь в ChatGPT/Codex или Google Gemini выше." Style="{StaticResource EmptyStateText}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
