<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="TrayDashboardWindow"
        Width="1000" Height="672" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" SizeToContent="Manual" WindowStartupLocation="Manual"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="TrayMetricCard" TargetType="Border">
            <Setter Property="Background" Value="#0C1A2A"/><Setter Property="BorderBrush" Value="#1C344D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="TrayActionButton" TargetType="Button">
            <Setter Property="Height" Value="58"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EAF1FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#102A44"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#173A5D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrayKicker" TargetType="TextBlock"><Setter Property="Foreground" Value="#7F96AE"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="TrayLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#90A5BC"/><Setter Property="FontSize" Value="11"/></Style>
    </Window.Resources>
    <Border CornerRadius="18" BorderBrush="#34506B" BorderThickness="1" Background="#06111E" Padding="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.48" Color="#000000"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="660"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="17,0,0,17" Background="#071522" Padding="20,18,18,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="132"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="138"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" BorderBrush="#2584FF" BorderThickness="1.5" Background="#0B2138" VerticalAlignment="Top"><Image x:Name="TrayBrandLogo" Margin="5" Stretch="Uniform"/></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="OmniBridge" FontSize="23" FontWeight="SemiBold" Foreground="#F3F7FC"/><Border x:Name="TrayActiveBadge" Margin="12,1,0,0" Height="28" CornerRadius="7" Background="#103B2D" BorderBrush="#176044" BorderThickness="1" Padding="11,0"><TextBlock x:Name="TrayActiveBadgeText" Text="АКТИВЕН" Foreground="#56E68A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></Border></StackPanel><TextBlock Text="Universal AI Gateway" Foreground="#91A5BD" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,2,0"><Ellipse x:Name="TrayConnectionDot" Width="10" Height="10" Fill="#45DC6D" Margin="0,2,8,0"/><TextBlock x:Name="TrayConnectionText" Text="Подключено" Foreground="#B8C7D8" FontSize="12"/></StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0B1B2B" BorderBrush="#1B334A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="СТАТУС СЕРВЕРА" Style="{StaticResource TrayKicker}"/>
                            <Border Grid.Row="1" Background="#0D2134" BorderBrush="#193B59" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#0E3354"><Path Data="M4,5 H20 V11 H4 Z M4,14 H20 V20 H4 Z M7,8 H9 M7,17 H9" Stroke="#41B9FF" StrokeThickness="1.8" Stretch="Uniform" Margin="7"/></Border>
                                    <StackPanel Grid.Column="1" Margin="12,-1,0,0"><TextBlock Text="Локальный сервер" Foreground="#EAF1FA" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="TrayEndpoint" Text="127.0.0.1:4142" Foreground="#91A5BD" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right"><Border x:Name="TrayServerBadge" Background="#123A26" BorderBrush="#1F6B40" BorderThickness="1" CornerRadius="6" Padding="10,4"><TextBlock x:Name="TrayServerBadgeText" Text="ВСЁ РАБОТАЕТ" Foreground="#56E68A" FontSize="11" FontWeight="Bold"/></Border><TextBlock x:Name="TrayUptime" Text="Uptime: 00:00:00" Foreground="#A9B9C9" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource TrayMetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TrayApiCount" Text="0" FontSize="25" Foreground="#41B9FF" FontWeight="SemiBold"/><TextBlock Text="API подключено" Foreground="#D6E1EC" FontSize="11.5"/><TextBlock x:Name="TrayApiSub" Text="0 настроено" Foreground="#5689B6" FontSize="10.5" Margin="0,3,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource TrayMetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TrayModelCount" Text="0" FontSize="25" Foreground="#B987FF" FontWeight="SemiBold"/><TextBlock Text="Доступно моделей" Foreground="#D6E1EC" FontSize="11.5"/><TextBlock Text="в Registry" Foreground="#7E6AA6" FontSize="10.5" Margin="0,3,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource TrayMetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TrayAccountCount" Text="0" FontSize="25" Foreground="#58E888" FontWeight="SemiBold"/><TextBlock Text="Аккаунта" Foreground="#D6E1EC" FontSize="11.5"/><TextBlock x:Name="TrayAccountSub" Text="0 настроено" Foreground="#5A9F72" FontSize="10.5" Margin="0,3,0,0"/></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource TrayMetricCard}"><StackPanel><TextBlock x:Name="TrayAgentCount" Text="0" FontSize="25" Foreground="#F2D45C" FontWeight="SemiBold"/><TextBlock Text="Agent Ready" Foreground="#D6E1EC" FontSize="11.5"/><TextBlock Text="моделей" Foreground="#9F8D53" FontSize="10.5" Margin="0,3,0,0"/></StackPanel></Border>
                    </Grid>

                    <Border x:Name="TrayGigaCard" Grid.Row="3" Visibility="Collapsed" Background="#0B1A2A" BorderBrush="#1D374F" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                            <Grid><TextBlock x:Name="TrayGigaTitle" Text="GIGACHAT API · ЦИКЛ OAUTH ТОКЕНА" Foreground="#DCE7F2" FontSize="11.5" FontWeight="SemiBold"/><Button x:Name="TrayGigaNext" Content="GigaChat" Background="Transparent" BorderThickness="0" Foreground="#7E96AE" FontSize="10.5" HorizontalAlignment="Right" Cursor="Hand" Padding="6,0"/></Grid>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TrayGigaTokens" Text="0 токенов за 24ч" Foreground="#55E48A" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TrayGigaSession" Text="  · сессия 0" Foreground="#8DA1B7" FontSize="11" VerticalAlignment="Center" Margin="8,3,0,0"/></StackPanel><TextBlock x:Name="TrayGigaCountdown" Grid.Column="1" Text="OAuth: —" Foreground="#F1D45E" FontSize="13" VerticalAlignment="Center"/></Grid>
                            <Grid Grid.Row="2"><ProgressBar x:Name="TrayGigaProgress" Minimum="0" Maximum="1800" Value="0" Height="5" Background="#152A3D" Foreground="#3ED47A" BorderThickness="0" VerticalAlignment="Top"/><TextBlock x:Name="TrayGigaRate" Text="Скорость сессии: 0 ток/мин" Foreground="#8298AF" FontSize="10.5" HorizontalAlignment="Right" Margin="0,9,0,0"/></Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#0B1A2A" BorderBrush="#1D374F" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="АКТИВНОСТЬ (24Ч)" Style="{StaticResource TrayKicker}"/>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock x:Name="TrayRequests" Text="0" Foreground="#EAF1FA" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Запросов" Style="{StaticResource TrayLabel}"/><TextBlock x:Name="TrayErrors" Text="Ошибки: 0" Foreground="#6E869E" FontSize="10.5"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="TraySuccess" Text="0" Foreground="#55E48A" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Успешно" Style="{StaticResource TrayLabel}"/><TextBlock x:Name="TraySuccessRate" Text="0% success" Foreground="#648F74" FontSize="10.5"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock x:Name="TrayInputTokens" Text="0" Foreground="#B987FF" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Входящих токенов" Style="{StaticResource TrayLabel}"/><TextBlock x:Name="TrayAvgLatency" Text="AVG: —" Foreground="#766990" FontSize="10.5"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock x:Name="TrayOutputTokens" Text="0" Foreground="#F2A84D" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Исходящих токенов" Style="{StaticResource TrayLabel}"/><TextBlock x:Name="TrayP95Latency" Text="P95: —" Foreground="#8E714E" FontSize="10.5"/></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="5"/>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="#45DC6D" VerticalAlignment="Center"/><TextBlock Text="Безопасное локальное соединение" Grid.Column="1" Foreground="#55E48A" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="TrayVersion" Grid.Column="2" Text="OmniBridge" Foreground="#899FB6" FontSize="11" Margin="0,0,18,0" VerticalAlignment="Center"/><Button x:Name="TrayLogsLink" Grid.Column="3" Content="Логи" Background="Transparent" Foreground="#B8C8D8" BorderThickness="0" Cursor="Hand"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="0,17,17,0" Background="#0A1726" BorderBrush="#1B3047" BorderThickness="1,0,0,0" Padding="18,20,18,16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="УПРАВЛЕНИЕ" Style="{StaticResource TrayKicker}" FontSize="12"/>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="TrayStartButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#113826" VerticalAlignment="Center"><Path Data="M8,5 21,12 8,19 Z" Fill="#55E48A" Stretch="Uniform" Margin="8"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Запустить сервер" Foreground="#EAF1FA" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="TrayStartSub" Text="Сервер работает" Foreground="#55E48A" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayStopButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#3A1A22" VerticalAlignment="Center"><Rectangle Width="12" Height="12" Stroke="#FF6868" StrokeThickness="2"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Остановить сервер" Foreground="#EAF1FA" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Остановить обработку API" Foreground="#9AAABD" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayRefreshSessions" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#102E4A" VerticalAlignment="Center"><Path Data="M20,7 V3 L17,6 A8,8 0 1 0 20,16 M20,7 H15" Stroke="#41B9FF" StrokeThickness="1.8" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Обновить сессии" Foreground="#EAF1FA" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="TrayRefreshSub" Text="API и Account Connector" Foreground="#9AAABD" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayCheckUpdates" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#2D2147" VerticalAlignment="Center"><Path Data="M20,7 V3 L17,6 A8,8 0 1 0 20,16 M20,7 H15" Stroke="#B987FF" StrokeThickness="1.8" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Проверить обновления" Foreground="#EAF1FA" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="TrayUpdateSub" Text="Источник обновлений не настроен" Foreground="#9AAABD" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></Grid></Button>
                        <Button x:Name="TraySettingsButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#19283A" VerticalAlignment="Center"><Path Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 0 0 12,8 M12,2 L14,5 18,4 19,8 22,10 20,13 21,17 17,19 15,22 12,20 9,22 7,19 3,17 4,13 2,10 5,8 6,4 10,5 Z" Stroke="#B9C8D8" StrokeThickness="1.2" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Настройки" Foreground="#EAF1FA" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Router, backup и сервис" Foreground="#9AAABD" FontSize="10.5" Margin="0,2,0,0"/></StackPanel></Grid></Button>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,5"><Border Height="1" Background="#20364E" VerticalAlignment="Center"/></Grid>
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="ИНФОРМАЦИЯ" Style="{StaticResource TrayKicker}" Margin="8,0,0,5"/>
                        <Button x:Name="TrayOpenDashboard" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#102E4A"><Path Data="M3,12 H8 L11,6 15,18 18,11 22,11" Stroke="#41B9FF" StrokeThickness="1.8" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Открыть панель" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Показать главное окно" Foreground="#9AAABD" FontSize="10.5"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayStatisticsButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#352B15"><Path Data="M6,19 V12 M12,19 V7 M18,19 V10" Stroke="#F2D45C" StrokeThickness="2" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Статистика" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Dashboard · активность 24ч" Foreground="#9AAABD" FontSize="10.5"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayVSCodeButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#103236"><Path Data="M8,5 2,12 8,19 M16,5 22,12 16,19 M14,2 10,22" Stroke="#42D5D8" StrokeThickness="1.7" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Интеграция VS Code" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="TrayVSCodeSub" Text="Статус подключения" Foreground="#9AAABD" FontSize="10.5"/></StackPanel></Grid></Button>
                        <Button x:Name="TrayHelpButton" Style="{StaticResource TrayActionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#19283A"><TextBlock Text="?" Foreground="#B9C8D8" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Справка" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Документация и помощь" Foreground="#9AAABD" FontSize="10.5"/></StackPanel></Grid></Button>
                    </StackPanel>
                    <Border Grid.Row="5" BorderBrush="#3F2430" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Button x:Name="TrayExitButton" Style="{StaticResource TrayActionButton}" Height="56"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#3A1A22"><Path Data="M12,3 V12 M6,6 A8,8 0 1 0 18,6" Stroke="#FF6868" StrokeThickness="2" Stretch="Uniform" Margin="7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Выход" Foreground="#FF9AA6" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="Закрыть приложение" Foreground="#A77780" FontSize="10.5"/></StackPanel></Grid></Button></Border>
                    <Border x:Name="TrayToast" Grid.RowSpan="6" Background="#EE112238" BorderBrush="#31557A" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Visibility="Collapsed"><TextBlock x:Name="TrayToastText" Text="Готово" Foreground="#DCEBFF" FontSize="11.5"/></Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
