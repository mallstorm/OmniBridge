<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="OmniWindow"
        Title="OmniBridge — Universal AI Gateway"
        Width="1260" Height="740" MinWidth="1260" MinHeight="740" MaxWidth="1260" MaxHeight="740"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" SnapsToDevicePixels="True">
    <Border CornerRadius="12" Background="{StaticResource AppBrush}" BorderBrush="#2B415B" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.65"/></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="#070D17" BorderBrush="#15263A" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="BtnMinimize" Style="{StaticResource TransparentButton}" Width="38" Height="31" Foreground="{StaticResource Text2Brush}" FontSize="16" Content="−"/>
                        <Button x:Name="BtnClose" Style="{StaticResource TransparentButton}" Width="42" Height="31" Foreground="{StaticResource Text2Brush}" FontSize="17" Content="×"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1B3550" BorderThickness="0,0,1,0" CornerRadius="0,12,12,12">
                    <Grid Margin="12,12,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="#4AC3FF" BorderThickness="1" Background="#0A2C58" Effect="{StaticResource GlowBlue}" VerticalAlignment="Top" Margin="0,7,0,0">
                                <Image x:Name="BrandLogo" Width="36" Height="36" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="7,1,0,0">
                                <TextBlock Text="OmniBridge" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/>
                                <TextBlock Text="Universal AI Gateway" FontSize="10.5" Foreground="{StaticResource Text2Brush}" Margin="0,1,0,0"/>
                                <TextBlock x:Name="SidebarVersion" Text="v1.0.0-rc7" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="ОСНОВНОЕ" Style="{StaticResource Kicker}" Margin="8,0,0,5"/>
                                <RadioButton x:Name="NavDashboard" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="True">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconHome}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Fill="Transparent" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Статус" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.5"/></StackPanel>
                                </RadioButton>

                                <TextBlock Text="ПРОВАЙДЕРЫ" Style="{StaticResource Kicker}" Margin="8,13,0,5"/>
                                <RadioButton x:Name="NavApi" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconKey}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="API Ключи (Setup)" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavAccounts" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconAccount}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Аккаунты (Login)" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavModels" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCube}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Модели" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavDoctor" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDoctor}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Model Doctor" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavRouter" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconArrow}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Маршрутизация" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavIntegration" GroupName="Navigation" Style="{StaticResource NavItem}" ToolTip="Интеграция">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCode}" Stroke="#28A9FF" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Интеграция" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavServices" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Сервисы" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>

                                <TextBlock Text="ИНСТРУМЕНТЫ" Style="{StaticResource Kicker}" Margin="8,13,0,5"/>
                                <RadioButton x:Name="NavLogs" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconLog}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Логи" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavSettings" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="Настройки" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>

                                <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource Kicker}" Margin="8,13,0,5"/>
                                <RadioButton x:Name="NavAbout" GroupName="Navigation" Style="{StaticResource NavItem}">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInfo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="О программе" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.2"/></StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#0B1A28" BorderBrush="#17344A" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="SidebarServerDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,3,0,0" Effect="{StaticResource GlowGreen}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SidebarServerText" Text="Сервер запущен" Foreground="{StaticResource SuccessBrush}" FontSize="10.5"/>
                                    <TextBlock x:Name="SidebarEndpoint" Text="http://127.0.0.1:4142" Foreground="{StaticResource Text2Brush}" FontSize="9.5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                    <Grid x:Name="PageHost" Grid.Row="0" Background="{StaticResource AppBrush}"/>
                    <Border Grid.Row="1" Background="#07101D" BorderBrush="#182C42" BorderThickness="0,1,0,0" CornerRadius="0,0,12,0">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#241756" BorderBrush="#6B3DDD" BorderThickness="1">
                                    <Path Data="{StaticResource IconInfo}" Stroke="#B499FF" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HintTitle" Text="Подсказка" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/>
                                    <TextBlock x:Name="HintText" Text="Model Doctor проверяет реальные возможности моделей перед экспортом." FontSize="10.5" Foreground="{StaticResource Text2Brush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnGlobalDoctor" Style="{StaticResource PrimaryButton}" Height="32" Content="Запустить проверку" Margin="0,0,10,0"/>
                                <Button x:Name="BtnGlobalRefresh" Style="{StaticResource IconButton}" Height="32" Width="34" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="BtnGlobalSettings" Style="{StaticResource IconButton}" Height="32" Width="34">
                                    <Path Data="{StaticResource IconSettings}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="ToastHost" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" MinWidth="260" MaxWidth="420" Background="#E5101B2A" BorderBrush="#31527A" BorderThickness="1" CornerRadius="10" Padding="12,9" Visibility="Collapsed" Panel.ZIndex="50">
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="11.5"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
